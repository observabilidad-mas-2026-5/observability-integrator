OTEL_ENABLED=true
API_PORT=28000
PROMETHEUS_PORT=29090
GRAFANA_PORT=23000
JAEGER_PORT=26686
OTLP_GRPC_PORT=24317
OTLP_HTTP_PORT=24318
# LOCAL ONLY. Change before any external exposure.
POSTGRES_PASSWORD=local-lab-only
GRAFANA_PASSWORD=local-lab-only

# data-service receives DATABASE_HOST, DATABASE_PORT, DATABASE_USER,
# DATABASE_NAME, DATABASE_PASSWORD, DATABASE_SSLMODE and DATABASE_SSLROOTCERT.
# Compose sets local PostgreSQL explicitly with DATABASE_SSLMODE=disable.
# Outside local Compose, TLS defaults to verify-full; mount the RDS CA bundle
# and set DATABASE_SSLROOTCERT to its container path. Inject DATABASE_PASSWORD
# from Secrets Manager at deployment time; never store a real value here.
# DATABASE_URL, when set, overrides the individual connection variables.

# Chaos is opt-in on Service A and Service B; never enabled by this template.
CHAOS_ENABLED=false
CHAOS_EXPIRES_AT=0
DATA_CHAOS_ENABLED=false
DATA_CHAOS_EXPIRES_AT=0
DATA_CHAOS_APPLICATION_ID=
